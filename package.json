{
  "name": "alertship",
  "version": "1.0.1",
  "description": "A production-grade Telegram error logger for Node.js, capturing crashes, resource usage, and request context.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx tests/test.ts",
    "dev": "tsx watch tests/test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saminwankwo/telegram-logger.git"
  },
  "bugs": {
    "url": "https://github.com/saminwankwo/telegram-logger/issues"
  },
  "homepage": "https://github.com/saminwankwo/telegram-logger#readme",
  "keywords": [
    "telegram",
    "logger",
    "error-handler",
    "monitoring",
    "node.js",
    "typescript",
    "sentry-alternative",
    "crash-report"
  ],
  "author": "Nwankwo Samuel",
  "license": "ISC",
  "type": "module",
  "dependencies": {},
  "peerDependencies": {
    "dotenv": ">=16"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
